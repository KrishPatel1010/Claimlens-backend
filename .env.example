# ClaimLens Backend — Environment Variables Template
# Copy this file to .env and fill in the required secrets.

# ==========================================
# External Service API Keys
# ==========================================
# SerpApi Key (Used for YouTube Transcript, Scholar, Finance, and Search engines)
SERPAPI_KEY=your_serpapi_key_here

# Google Fact Check Tools API Key (Free Google Cloud API Key for claims:search)
GOOGLE_FACT_CHECK_KEY=your_google_fact_check_key_here

# LLM Provider Key (OpenAI, Anthropic, or Gemini for claim extraction and similarity grading)
LLM_API_KEY=your_llm_api_key_here

# ==========================================
# Structured Storage (Supabase / PostgreSQL)
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ==========================================
# Hot Cache (Redis)
# ==========================================
REDIS_URL=redis://localhost:6379

# ==========================================
# Application Configuration
# ==========================================
PORT=4000
NODE_ENV=development
